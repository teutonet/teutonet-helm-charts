? pulls the username/password from the source secret via top-level valuesFrom targets, resolved inside the static manifest string by cetic/static's own tpl call, instead of embedding them directly
: 1: |
    apiVersion: helm.toolkit.fluxcd.io/v2
    kind: HelmRelease
    metadata:
      labels:
        app.kubernetes.io/component: prometheus-secret
        app.kubernetes.io/instance: test-release
        app.kubernetes.io/managed-by: Helm
        app.kubernetes.io/name: managed-monitoring
        helm.sh/chart: managed-monitoring-0.1.0
      name: test-release-pw
      namespace: NAMESPACE
    spec:
      chart:
        spec:
          chart: static
          sourceRef:
            kind: HelmRepository
            name: cetic
            namespace: flux-system
          version: 0.1.1
      driftDetection:
        mode: enabled
      install:
        remediation:
          retries: -1
      interval: 1h
      kubeConfig:
        secretRef:
          name: test-cluster-kubeconfig
      releaseName: prometheus-write
      storageNamespace: teuto-managed-operators
      targetNamespace: teuto-managed-operators
      uninstall:
        disableWait: true
      values:
        static: |
          apiVersion: v1
          kind: Secret
          metadata:
            name: prometheus-write
            labels:
              app.kubernetes.io/name: managed-monitoring
              helm.sh/chart: managed-monitoring-0.1.0
              app.kubernetes.io/instance: test-release
              app.kubernetes.io/managed-by: Helm
              app.kubernetes.io/component: prometheus-secret
          type: Opaque
          stringData:
            username: {{ .Values.username }}
            password: {{ .Values.password }}
      valuesFrom:
        - kind: Secret
          name: some-customer-specific-secret-name
          optional: false
          targetPath: username
          valuesKey: username
        - kind: Secret
          name: some-customer-specific-secret-name
          optional: false
          targetPath: password
          valuesKey: password
