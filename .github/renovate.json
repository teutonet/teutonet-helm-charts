{
  "extends": [
    "config:best-practices"
  ],
  "assigneesFromCodeOwners": true,
  "assigneesSampleSize": 1,
  "configMigration": true,
  "platformAutomerge": true,
  "semanticCommitScope": "{{parentDir}}/dependencies",
  "additionalBranchPrefix": "{{parentDir}}-",
  "separateMinorPatch": true,
  "automerge": true,
  "prHourlyLimit": 50,
  "prConcurrentLimit": 20,
  "labels": [
    "dependencies"
  ],
  "nix": {
    "enabled": true
  },
  "customDatasources": {
    "grafana-dashboard": {
      "defaultRegistryUrlTemplate": "https://grafana.com/api/dashboards/{{packageName}}",
      "format": "json",
      "transformTemplates": [
        "{\"releases\": [{\"version\": $string(revision)}]}"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)values\\.yaml$/"
      ],
      "matchStrings": [
        "gnetId: (?<packageName>\\d+)\\n\\s+revision: (?<currentValue>\\d+)"
      ],
      "versioningTemplate": "regex:^(?<minor>\\d+)$",
      "datasourceTemplate": "custom.grafana-dashboard"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)values\\.yaml$/"
      ],
      "matchStrings": [
        " {4}\\S+:\\n {6}url: (?<registryUrl>https://\\S+)\\n {6}charts:(?:\\s+\\S+( \\S+){0,2}: [0-9.x]+\\s)+",
        " {8}(?<depName>\\S+): (?<currentValue>\\S+)\\s"
      ],
      "matchStringsStrategy": "recursive",
      "versioningTemplate": "helm",
      "datasourceTemplate": "helm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)values\\.yaml$/"
      ],
      "matchStrings": [
        " {4}\\S+:\\n {6}url: oci://(?<ociUrl>\\S+)\\n {6}charts:(?:\\s+\\S+: [0-9.x]+\\s)+",
        " {8}(?<depName>\\S+): (?<currentValue>\\S+)\\s"
      ],
      "matchStringsStrategy": "recursive",
      "versioningTemplate": "helm",
      "datasourceTemplate": "docker",
      "registryUrlTemplate": "https://{{{ociUrl}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)values\\.yaml$/"
      ],
      "matchStrings": [
        " {4}\\S+:\\n {6}url: (?<packageName>\\S+)\\n {6}semver: [\"']?(?<currentValue>[0-9.]+)[\"']?\\s"
      ],
      "versioningTemplate": "semver",
      "datasourceTemplate": "git-tags",
      "extractVersionTemplate": "^v?(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": [
        "charts/stellio-context-broker/**"
      ],
      "dependencyDashboardApproval": true
    }
  ]
}
